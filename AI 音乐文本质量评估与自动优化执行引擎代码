def _load_json(path: str) -> Optional[Dict[str, float]]:
    if not path:
        return None
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise SystemExit(f"--scores/--vars 必须是 JSON 对象：{path}")
    return {str(k): float(v) for k, v in data.items()}


def main(argv: Optional[Sequence[str]] = None) -> int:
    p = argparse.ArgumentParser(prog="engine", description=f"AI 音乐文本执行引擎 {ENGINE_VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("selftest", help="运行数值自测")
    sub.add_parser("demo", help="打印七场景行为表")

    pc = sub.add_parser("create", help="Phase 1 创作工作台")
    pc.add_argument("--seed", required=True)
    pc.add_argument("--lang", default="cmn", choices=["yue", "cmn"])
    pc.add_argument("--style", default="慢歌钢琴叙事", choices=list(STYLE_META))
    pc.add_argument("--arc", default="识穿→认领", choices=list(C3AC_KB["弧线模板"]))

    for name, need_fix in (("evaluate", False), ("optimize", True)):
        pe = sub.add_parser(name, help="Phase 2 评估" if not need_fix else "Phase 2→3→4 有限闭环")
        pe.add_argument("--styles", required=True)
        pe.add_argument("--lyrics", required=True)
        pe.add_argument("--lang", default="cmn", choices=["yue", "cmn"])
        pe.add_argument("--style", default="慢歌钢琴叙事", choices=list(STYLE_META))
        pe.add_argument("--hook", default="")
        pe.add_argument("--scores", default="", help="人工评分 JSON（部分覆盖自动评分，优先级最高）")
        pe.add_argument("--vars", default="", help="四变量覆盖 JSON，如 {\"PAC_raw\": 6.2}")
        pe.add_argument("--target", type=float, default=85.0)
        if need_fix:
            pe.add_argument("--autofix", action="store_true", help="启用确定性自动补丁")

    args = p.parse_args(argv)
    if args.cmd == "selftest":
        run_self_test()
        return 0
    if args.cmd == "demo":
        run_demo()
        return 0
    if args.cmd == "create":
        print(create_workspace(args.seed, args.lang, args.style, args.arc))
        return 0

    with open(args.styles, encoding="utf-8") as fh:
        st = fh.read()
    with open(args.lyrics, encoding="utf-8") as fh:
        ly = fh.read()
    manual = _load_json(args.scores)
    var_override = _load_json(args.vars)
    asset = Asset(st, ly, args.lang, args.style, args.hook)
    print(run_pipeline(asset, args.hook, manual, var_override,
                       autofix=bool(getattr(args, "autofix", False)), target=args.target))
    return 0


if __name__ == "__main__":
    sys.exit(main())
