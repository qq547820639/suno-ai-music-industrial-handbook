def create_workspace(seed: str, lang: str, style_name: str, arc: str = "识穿→认领") -> str:
    meta = STYLE_META[style_name]
    fast = meta["fast"]
    chars = [c for c in _hook_clean(seed)]
    cands: List[str] = []
    for n in (4, 3, 2):
        for i in range(max(len(chars) - n + 1, 0)):
            cands.append("".join(chars[i:i + n]))
    cands = list(dict.fromkeys(cands + chars))
    rows = []
    for h in [c for c in cands if 0 < len(c) <= 4]:
        tail = h[-1]
        tone = lookup_tone(tail, lang) or "?"
        if tone in TONE_BASE[lang]:
            ev = ToneEvent(lang, style_name, tone, "hook")
            raw = tsmi_raw([ev])
            coef = ev.coef
        else:
            raw, coef = 0.0, 1.0
        rows.append((h, tone, coef, raw))
    rows.sort(key=lambda r: -r[3])
    hook_tbl = "\n".join(f"  {h:<6} 尾字声调 {t:<2} 系数 {c:<5} TSMI_raw {r:6.2f}" for h, t, c, r in rows[:6]) \
        or "  （种子无法切出 ≤4 字候选，请人工给 Hook）"
    profile = FAST_PROFILE if fast else SLOW_PROFILE
    pauses = "\n".join(f"  [{s}] 理想 {ideal}s 权重 {w}  →  [pause {ideal}s]" for s, ideal, w in profile)
    tail_tag = "[Abrupt Stop]" if fast else "[silence 5.0s]"
    first, last = C3AC_KB["弧线模板"][arc]
    claim = C3AC_KB["认领"]["default"][lang][0]
    tpl = STYLE_TEMPLATES[(style_name, lang)]
    return "\n".join([
        f"═══ PHASE 1 创作工作台（{ENGINE_VERSION}）═══",
        f"种子：{seed}   语言：{lang}   风格：{style_name}   BPM：{meta['bpm']}   弧线：{arc}",
        "",
        "【Step 1 · 物象确定 + PAC 四节点规划】",
        f"  核心物象：{seed}（检验：可否『戴上/除下/裂开/长进肉里』）",
        "  节点1 initial(0.5)：物象首次出现        推荐寄生：temporal ×1.8（记得/那年/旧）",
        "  节点2 contact(1.0)：与身体接触           推荐寄生：spatial ×1.2（贴在胸口/袋口）",
        "  节点3 turn(1.5)：物象状态改变            推荐寄生：tactile ×1.5（冷/硬/黏）",
        "  节点4 anchor(2.0)：尾奏最终落点          推荐寄生：temporal ×1.8（旧/褪色）",
        "  满配预估 PAC_raw = 9.0 → PAC_n = 1.00；仅 2 节点无寄生时 PAC_n = 0.17（触发 CriticalPenalty）",
        "",
        "【Step 2 · Hook 设计（TSMI 预规划）】",
        hook_tbl,
        f"  风格最佳声调：{STYLE_TONE[lang][style_name]['best']}｜"
        f"禁用（负系数）：{STYLE_TONE[lang][style_name]['banned']}",
        "  要求：Hook ≤4 字，重复 ≥4 次且情绪递进；各次复唱尾字保持同声调",
        "",
        "【Step 3 · 弧线设计（C3AC 预规划）】",
        f"  模板 {arc}：首阶段 {first} → 末阶段 {last}",
        "  副歌3 首句示例（D）：原来我一直都知，只是唔出声" if lang == "yue"
        else "  副歌3 首句示例（D）：原来我早就知道，只是不出声",
        f"  副歌3 末句示例（C）：{claim}佢啦，[物象] 继续喺个袋度" if lang == "yue"
        else f"  副歌3 末句示例（C）：{claim}吧，[物象] 就让它留在那里",
