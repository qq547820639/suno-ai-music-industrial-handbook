def lookup_tone(ch: str, lang: str) -> Optional[str]:
    """规则查表 → 可选开源适配器（未核验，缺失自动降级）。"""
    if ch in TONE_TABLE[lang]:
        return TONE_TABLE[lang][ch]
    try:                                   # 适配器：训练记忆中的接口，未核验版本/LICENSE
        if lang == "yue":
            import pycantonese  # type: ignore
            jp = pycantonese.characters_to_jyutping(ch)
            if jp and jp[0] and jp[0][1]:
                syl = jp[0][1][-1]
                return syl if syl in TONE_BASE["yue"] else None
        else:
            from pypinyin import Style, pinyin  # type: ignore
            s = pinyin(ch, style=Style.TONE3, neutral_tone_with_five=True)
            if s and s[0]:
                m = re.search(r"([1-5])$", s[0][0])
                if m:
                    t = m.group(1)
                    return "0" if t == "5" else t
    except Exception:
        return None
    return None


def style_coef(lang: str, style: str, tone: str) -> float:
    rule = STYLE_TONE[lang][style]
    if tone in rule["best"]:
        return rule["best"][tone]
    if tone in rule["banned"]:
        return -rule["banned"][tone]      # F4：禁用声调取负
    return 1.0                            # 表外声调：中性


