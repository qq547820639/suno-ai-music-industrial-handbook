@dataclass
class Evaluation:
    feats: Features
    styles_scores: Dict[str, float]
    lyrics_scores: Dict[str, float]
    notes: List[ScoreNote]
    vetoes: List[str]
    tee: TEEResult
    styles_p: float
    lyrics_p: float
    total: float
    grade: str
    diagnostics: List[Diagnostic]


def _overwrite(ss: Dict[str, float], notes: List[ScoreNote], code: str,
               val: float, src: str) -> None:
    """写入并同步评分说明（替换式，避免卡片上数值与理由不一致）。"""
    ss[code] = round(val, 2)
    for n in notes:
        if n.code == code:
            n.score = ss[code]
            n.reason = f"{n.reason}｜{src}={ss[code]:g}"
            return
    notes.append(ScoreNote(code, ss[code], f"{src}={ss[code]:g}"))


def _remap(x: float, tiers: Sequence[Tuple[float, float]], floor: float) -> float:
    for th, val in tiers:
        if x >= th:
            return val
    return floor


def evaluate(a: Asset, hook_hint: str = "", manual: Optional[Dict[str, float]] = None,
             var_override: Optional[Dict[str, float]] = None) -> Evaluation:
    f = extract_features(a.styles, a.lyrics, a.lang, a.style_name, hook_hint or a.hook)
    ss, notes, vetoes = autoscore(f)

    vo = var_override or {}
    pn = pac_norm(vo["PAC_raw"]) if "PAC_raw" in vo else pac_norm(pac_raw(f.pac_nodes))
    tn = tsmi_norm(vo["TSMI_raw"]) if "TSMI_raw" in vo else tsmi_norm(tsmi_raw(f.tone_events))
    nn_raw = vo["NSRQ_raw"] if "NSRQ_raw" in vo else nsrq_raw(f.nsrq_slots, f.fast, f.abrupt_stop)
    nn = nsrq_norm(float(nn_raw), f.fast)                                   # F10
    cn = c3ac_norm(vo["C3AC_raw"]) if "C3AC_raw" in vo else c3ac_norm(c3ac_raw(*f.c3ac_dcl))
    tee = tee_from_norm(pn, tn, nn, cn, a.lang)

    # 变量回写修正相关维度（11.3）：V16←PAC，V20/V27←TSMI，V22/V26←NSRQ，V21←C3AC
    for code, val, src in (
        ("V16", _remap(pn, [(0.55, 35), (0.33, 30), (0.11, 20)], 12), f"PAC_n={pn:.2f}"),
        ("V20", _remap(tn, [(0.5, 45), (0.27, 38), (0.0, 28)], 18), f"TSMI_n={tn:.2f}"),
        ("V27", _remap(tn, [(0.5, 35), (0.27, 28), (0.0, 20)], 10), f"TSMI_n={tn:.2f}"),
        ("V22", _remap(nn, [(0.8, 40), (0.5, 32), (0.2, 24)], 12), f"NSRQ_n={nn:.2f}"),
        ("V26", _remap(nn, [(0.8, 25), (0.5, 20), (0.2, 14)], 6), f"NSRQ_n={nn:.2f}"),
        ("V21", _remap(cn, [(0.75, 55), (0.5, 47), (0.25, 40)], 28), f"C3AC_n={cn:.2f}"),
    ):
        _overwrite(ss, notes, code, float(val), f"变量回写·{src}")

    # B5：人工覆盖最后写入，不再被回写覆盖
    for k, v in (manual or {}).items():
        if k in ALL_DIMS:
            _overwrite(ss, notes, k, float(v), "人工评分覆盖")
        else:
            f.warnings.append(f"--scores 含未知维度键「{k}」，已忽略")

    sp = styles_percent(ss)
    lp = lyrics_percent(ss, a.lang)
    total = final_score(sp, lp, tee.offset(lp))
    return Evaluation(f, {k: v for k, v in ss.items() if k in STYLE_CODES},
                     {k: v for k, v in ss.items() if k in LYRICS_CODES},
                     notes, vetoes, tee, sp, lp, total, grade(total),
                     diagnose(ss, a.lang, tee, vetoes))


def render_full_card(ev: Evaluation, a: Asset) -> str:
    L: List[str] = ["━━━ PHASE 2 · FULL CARD ━━━", "━━━ STYLES 评估 ━━━"]
    for d in STYLE_DIMS:
        sc = ev.styles_scores.get(d.code, 0.0)
        note = next((n.reason for n in ev.notes if n.code == d.code), "")
        L.append(f"{d.code:<4}{d.name:<8}| {sc:>4}/{d.vmax} | {d.layer:<9}| {note}")
    L.append(f"━━━\nStyles 加权分 = {ev.styles_p:.1f}/100（归一化分母 {STYLE_DENOM:.0f}，V14 为展示项）")
    L.append("\n━━━ LYRICS 评估 ━━━")
    for d in LYRICS_DIMS:
        sc = ev.lyrics_scores.get(d.code, 0.0)
        mx = lyrics_max(d.code, a.lang)
        note = next((n.reason for n in ev.notes if n.code == d.code), "")
        L.append(f"{d.code:<4}{d.name:<8}| {sc:>5}/{mx} | {d.layer:<9}| {note}")
    L.append(f"━━━\nLyrics 加权分 = {ev.lyrics_p:.1f}/100"
             f"（原始 {sum(ev.lyrics_scores.values()):.1f}/{LYRICS_FULL[a.lang]:.0f}）")

    t, f2 = ev.tee, ev.feats
    L.append("\n━━━ v2.1.2 四变量计算 ━━━")
    L.append(f"PAC_raw  = Σ(节点权重×形态系数) = {pac_raw(f2.pac_nodes):.2f}   "
             f"节点={[(n.kind, n.parasite) for n in f2.pac_nodes]}")
    L.append(f"PAC_n    = clamp({pac_raw(f2.pac_nodes):.2f}/9.0) = {t.pac_n:.3f}")
    L.append(f"TSMI_raw = 2.0×Σ(v·c·p)/Σ(p) = {tsmi_raw(f2.tone_events):.2f}  事件数={len(f2.tone_events)}")
    L.append(f"TSMI_n   = clamp({tsmi_raw(f2.tone_events):.2f}/30, -1, 1) = {t.tsmi_n:.3f}")
    L.append(f"NSRQ_raw = Σ(clamp(实际/理想)×权重){' + AbruptStop' if f2.abrupt_stop else ''} = "
             f"{nsrq_raw(f2.nsrq_slots, f2.fast, f2.abrupt_stop):.2f}  槽位={f2.nsrq_slots}")
    L.append(f"NSRQ_n   = clamp(raw/{nsrq_denom(f2.fast):.1f}) = {t.nsrq_n:.3f}   （F10 分母随 profile 自适应）")
    L.append(f"C3AC     = 0.6·D + 0.7·C + 0.7·L = {c3ac_raw(*f2.c3ac_dcl):.2f}  (D,C,L)={f2.c3ac_dcl}")
    L.append(f"C3AC_n   = clamp({c3ac_raw(*f2.c3ac_dcl):.2f}/2.0) = {t.c3ac_n:.3f}")
    L.append(f"TEE_raw  = {BASE[a.lang]:.0f} + 32·{t.pac_n:.2f} + 24·{t.tsmi_n:.2f} + 20·{t.nsrq_n:.2f} "
             f"+ 28·{t.c3ac_n:.2f} + 16·{t.pac_n * t.tsmi_n:.3f} + 12·{t.nsrq_n * t.c3ac_n:.3f} = {t.tee_raw:.2f}")
    L.append(f"TEE_pct_raw = {t.tee_pct_raw:.2f}   "
             f"g=({t.g[0]:.3f},{t.g[1]:.3f},{t.g[2]:.3f},{t.g[3]:.3f})  G_struct={t.g_struct:.3f}")
    L.append(f"SoftPenalty = 35×(1−{t.g_struct:.3f}) = {t.soft_penalty:.2f}")
    L.append(f"CriticalPenalty: TSMI {t.crit_tsmi:.1f} + PAC {t.crit_pac:.1f} + C3AC {t.crit_c3ac:.1f} "
             f"= {t.critical_penalty:.2f}")
    L.append(f"TEE_pct_final = {t.tee_pct_final:.2f}   TEE_offset = {t.offset(ev.lyrics_p):+.2f}")
    L.append(f"\n━━━ 总分 ━━━\n最终总分 = {ev.styles_p:.1f}×0.4 + {ev.lyrics_p:.1f}×0.6 "
             f"+ {t.offset(ev.lyrics_p):+.2f} = {ev.total:.1f}\n等级 = {ev.grade}")
    L.append("\n━━━ TOP 5 问题诊断（按 11.1 优先级）━━━")
    for i, d in enumerate(ev.diagnostics, 1):
        L.append(f"{i}. [{d.rank}优/{d.layer}] {d.code}: {d.issue} → {d.fix}")
    if f2.warnings:
        L.append("\n━━━ 工程防呆告警 ━━━")
        for w in f2.warnings:
            L.append(f"  · {w}")
    return "\n".join(L)


def render_diff_card(diffs: Sequence[str], old: Evaluation, new: Evaluation,
                     ce: ConvergenceEngine) -> str:
    L = ["━━━ PHASE 3 · DIFF CARD ━━━"]
    L += list(diffs) or ["[UNCHANGED] 本轮无确定性补丁（剩余问题需人工艺术性修改）"]
    for code in sorted(set(old.lyrics_scores) | set(old.styles_scores)):
        o = old.styles_scores.get(code, old.lyrics_scores.get(code, 0.0))
        n = new.styles_scores.get(code, new.lyrics_scores.get(code, 0.0))
        if abs(float(n) - float(o)) > 0.01:
            L.append(f"[CHANGED] {code}: {o:.1f} → {n:.1f}")
    L.append(f"\n━━━ v2.1.2 变量重算 ━━━\nPAC_n {old.tee.pac_n:.2f}→{new.tee.pac_n:.2f} | "
             f"TSMI_n {old.tee.tsmi_n:.2f}→{new.tee.tsmi_n:.2f} | "
             f"NSRQ_n {old.tee.nsrq_n:.2f}→{new.tee.nsrq_n:.2f} | "
             f"C3AC_n {old.tee.c3ac_n:.2f}→{new.tee.c3ac_n:.2f}")
    L.append(f"━━━ 更新总分 ━━━\n{old.total:.1f} → {new.total:.1f} ({new.total - old.total:+.1f})")
    state, note = ce.verdict()
    L.append(f"收敛判定: {state}｜{note}")
    return "\n".join(L)


def render_snapshot(ev: Evaluation, a: Asset, ce: ConvergenceEngine) -> str:
    snap = " ".join(f"{k}:{ev.styles_scores.get(k, 0):g}" for k in STYLE_CODES)
    snap += f"  | Styles: {ev.styles_p:.1f}/100\n"
    snap = snap.rstrip("\n")
    snap += "\n" + " ".join(f"{k}:{ev.lyrics_scores.get(k, 0):g}" for k in LYRICS_CODES)
    snap += f"  | Lyrics: {sum(ev.lyrics_scores.values()):.1f}/{LYRICS_FULL[a.lang]:.0f} ({ev.lyrics_p:.1f}%)"
    t = ev.tee
    state, note = ce.verdict()
    risk: List[str] = []
    for d in STYLE_DIMS + LYRICS_DIMS:
        sc = float(ev.styles_scores.get(d.code, ev.lyrics_scores.get(d.code, 0.0)))
        mx = lyrics_max(d.code, a.lang)
        if norm_score(d.code, sc, a.lang) / mx <= 0.4:
            icon = "🔴" if d.layer == "Core" else "🟡" if d.layer == "Important" else "🟢"
            risk.append(f"[{icon}] {d.code} {d.name} = {sc:g}/{mx}")
    if abs(t.offset(ev.lyrics_p)) > 15:
        risk.append("[⚪] TEE_pct_final 与 Lyrics 百分制差距 > 15 分，需人工复核")
    meta = STYLE_META[a.style_name]
    return "\n".join([
        "━━━ PHASE 4 · SNAPSHOT CARD ━━━", snap,
        f"PAC_n:{t.pac_n:.2f} TSMI_n:{t.tsmi_n:.2f} NSRQ_n:{t.nsrq_n:.2f} C3AC_n:{t.c3ac_n:.2f}",
        f"TEE_pct_final:{t.tee_pct_final:.1f}  TEE_offset:{t.offset(ev.lyrics_p):+.1f}",
        f"最终总分: {ev.total:.1f}  等级: {ev.grade}",
        "\n━━━ 收敛状态 ━━━", f"[{state}] {note}",
        "\n━━━ 风险预警 ━━━", "\n".join(risk) or "  无",
        "\n━━━ 生成参数推荐（R7/R8）━━━",
        f"BPM: {meta['bpm']}（漂移风险 {meta['drift']}，建议 ±5 三点采样）",
        f"Weirdness: {meta['weird']}   Style Influence: {meta['infl']}",
        "Custom Mode: ON   Auto Instrumental: OFF   Auto Structure: OFF",
        "Audio Influence: 仅上传音频时启用   Personas/Voices: 启用后从 Styles 删去性别/声区描述",
        f"temperature（如前端支持）: {meta['temp']} —— 仅作生成参数，不写入 Styles 文本",
        "\n━━━ 最终文本 ━━━", f"[Styles · {len(a.styles)} 字符]\n{a.styles}\n\n[Lyrics]\n{a.lyrics}",
    ])


def run_pipeline(a: Asset, hook: str = "", manual: Optional[Dict[str, float]] = None,
                 var_override: Optional[Dict[str, float]] = None,
                 autofix: bool = False, target: float = 85.0) -> str:
    out: List[str] = [f"═══ 执行引擎 {ENGINE_VERSION}（有限闭环）｜{a.lang} · {a.style_name} · "
                      f"BPM {STYLE_META[a.style_name]['bpm']} · {'快歌' if a.fast else '慢歌'} ═══"]
    ce = ConvergenceEngine(target=target)
    cur = a
    ev = evaluate(cur, hook, manual, var_override)
    ce.record(1, ev.total, {**ev.styles_scores, **ev.lyrics_scores})
    out.append(render_full_card(ev, cur))
    if not autofix:
        out.append("\n（未启用 --autofix：Phase 3/4 未执行。加 --autofix 进入有限闭环。）")
        return "\n".join(out)

    for rnd in (2, 3):
        old = ev
        cur, diffs, touched = apply_fixes(cur, old.feats)
        ce.modified |= touched
        ev = evaluate(cur, hook, manual, var_override)
        ce.record(rnd, ev.total, {**ev.styles_scores, **ev.lyrics_scores})
        out.append("\n" + render_diff_card(diffs, old, ev, ce))
        state, _ = ce.verdict()
        if state.startswith("已收敛"):
            break
    out.append("\n" + render_snapshot(ev, cur, ce))
    return "\n".join(out)


