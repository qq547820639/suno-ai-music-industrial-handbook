def run_self_test() -> None:
    ok = 0

    def near(a: float, b: float, tol: float = 0.02, tag: str = "") -> None:
        nonlocal ok
        if abs(a - b) > tol:
            raise AssertionError(f"{tag}: {a} != {b} (tol {tol})")
        ok += 1

    def yes(cond: bool, tag: str = "") -> None:
        nonlocal ok
        if not cond:
            raise AssertionError(f"{tag}: 断言失败")
        ok += 1

    # —— 口径与极值 ——
    near(pac_raw([PacNode(k, "temporal") for k in ("initial", "contact", "turn", "anchor")]), 9.0, 1e-9, "PAC max")
    near(tsmi_raw([ToneEvent("yue", "慢歌钢琴叙事", "2", "hook")]), 30.0, 1e-9, "TSMI 上界")
    near(c3ac_raw(1, 1, 1), 2.0, 1e-9, "C3AC 上界")
    near(nsrq_raw(dict(zip([s for s, _i, _w in SLOW_PROFILE], [9, 9, 9, 9, 9]))), 5.8, 1e-9,
         "NSRQ 慢歌 max（F6 防刷分）")
    near(nsrq_norm(5.8, False), 1.0, 1e-9, "NSRQ 慢歌归一化（F10）")
    near(nsrq_raw(dict(zip([s for s, _i, _w in FAST_PROFILE], [1, 1, 1, 1])), fast=True, abrupt_stop=True),
         5.3, 1e-9, "NSRQ 快歌 max")
    near(nsrq_norm(5.3, True), 1.0, 1e-9, "NSRQ 快歌归一化（F10）")
    near(nsrq_denom(False), 5.8, 1e-9, "F10 慢歌分母")
    near(nsrq_denom(True), 5.3, 1e-9, "F10 快歌分母")
    near(styles_percent({d.code: 5.0 for d in STYLE_DIMS}), 100.0, 1e-9, "F1 归一化")
    near(styles_percent({**{d.code: 5.0 for d in STYLE_DIMS}, "V14": 1.0}), 100.0, 1e-9, "F7 V14 不回流")
    near(styles_percent({"V1": 7.0}), 15.0 / 103.0 * 100.0, 1e-9, "F9 超满分封顶")
    near(lyrics_percent({d.code: float(lyrics_max(d.code, "yue")) for d in LYRICS_DIMS}, "yue"),
