    # —— F12 段落解析 ——
    secs = split_sections("[Verse 1]\n甲\n[Bridge] [All Instruments Cut] [pause 0.5s]\n乙\n[Outro]\n丙\n[silence 5.0s]")
    yes([k for _t, k, _b in secs] == ["verse", "bridge", "outro"], f"F12 多标签行段落识别 {secs}")
    secs2 = split_sections("[pause 1.0s]\n正文\n[Energy: building]\n又一行")
    yes([k for _t, k, _b in secs2] == ["other"], f"F12 非段落标签不切分 {secs2}")

    # —— F11 中性声调事件 ——
    ev_n = ToneEvent("yue", "慢歌钢琴叙事", "?", "hook", neutral=True)
    near(ev_n.coef, 1.0, 1e-9, "F11 中性系数")
    near(ev_n.tone_score, NEUTRAL_TONE_SCORE, 1e-9, "F11 中性基分")

    # —— 行为特征速查表（粤语 base=340 / 470，歌词 85%）——
    table = [
        ("全满", (1.0, 1.0, 1.0, 1.0), (1.000, 0.00, 0.00, 100.00, 15.00)),
        ("中等偏上", (0.50, 0.73, 0.76, 0.50), (0.660, 11.89, 0.00, 76.01, -8.99)),
        ("均匀半(F2 更正)", (0.50, 0.50, 0.50, 0.50), (0.575, 14.88, 0.00, 70.02, -14.98)),
