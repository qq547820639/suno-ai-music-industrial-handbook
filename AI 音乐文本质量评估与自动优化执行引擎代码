    yes(any("ZZZ" in w for w in ev_m.feats.warnings), "未知维度键告警")
    out = run_pipeline(a, hook="锁", autofix=True)
    yes("SNAPSHOT CARD" in out, "有限闭环产出 Snapshot")

    f0 = extract_features(a.styles, a.lyrics, "yue", "慢歌钢琴叙事", "锁")
    a2, _d, _t = apply_fixes(a, f0)
    yes(len(re.findall(r"$$Outro", a2.lyrics, re.I)) == 1, "B9 Outro 唯一")
    yes(len(re.findall(r"\[Bridge", a2.lyrics, re.I)) == 1, "B9 Bridge 唯一")

    bare = Asset(sample_styles, "[Verse 1]\n原来旧锁生锈，仍锁着那件事\n[Chorus 1]\n锁住\n",
