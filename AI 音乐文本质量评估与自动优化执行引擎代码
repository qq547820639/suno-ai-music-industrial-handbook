    yes(BAD_PAUSE_RE.findall("x [pause] y [停顿] z [pause 2.0s]") == ["[pause]", "[停顿]"], "B2 BAD_PAUSE")
    yes(PAUSE_RE.findall("[pause 0.5s] [silence 5.0s] [pause]") == ["0.5", "5.0"], "B2 PAUSE")
    yes(BAR_RE.findall("[VERSE 2 8 bars]") == ["8"], "B7 bar count 抓小节数")
    yes(BAR_RE.findall("[Verse 2]") == [], "B7 无单位不计")
