    fl = extract_features(al.styles, al.lyrics, "yue", "慢歌钢琴叙事", "锁")
    al2, _ld, _lt = apply_fixes(al, fl)
    yes(len(al2.styles) <= 200 or "Do not change" in al2.lyrics, "15.1 压缩生效")
    yes(al2.styles.split(", ")[0].startswith("descriptor number 1") or len(al.styles) <= 200,
