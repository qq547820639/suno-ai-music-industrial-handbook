        ("声调极端错(外推锚点)", (1.0, -1.0, 1.0, 1.0), (0.000, 35.00, 20.00, 28.40, -56.60)),
        ("全零", (0.0, 0.0, 0.0, 0.0), (0.150, 29.75, 20.00, 22.59, -62.41)),
        ("仅物象好(F2 更正)", (1.0, 0.0, 0.0, 0.0), (0.265, 25.72, 10.00, 43.43, -41.57)),
    ]
    for name, vals, exp in table:
        r = tee_from_norm(*vals, lang="yue")
        near(r.g_struct, exp[0], 0.002, f"{name}/G")
        near(r.soft_penalty, exp[1], 0.02, f"{name}/soft")
        near(r.critical_penalty, exp[2], 0.01, f"{name}/crit")
        near(r.tee_pct_final, exp[3], 0.02, f"{name}/final")
        near(r.offset(85.0), exp[4], 0.02, f"{name}/offset")

    near(tee_from_norm(1, 1, 1, 1, "cmn").tee_pct_final, 100.0, 0.02, "cmn 全满")

    # —— TSMI 边界可达性（B12：程序化求真极值）——
    cand = [tsmi_raw([ToneEvent(lg, st, tn, "hook")] * 4)
            for lg in TONE_BASE for st in STYLE_TONE[lg] for tn in TONE_BASE[lg]]
    worst, best = min(cand), max(cand)
    near(worst, -9.6, 1e-9, "TSMI KB 内可达下界")
    near(best, 30.0, 1e-9, "TSMI 可达上界")
    yes(tsmi_norm(worst) > -1.0, "TSMI_n = −1.0 为夹紧边界，非可达态")
    near(tsmi_norm(worst), worst / 30.0, 1e-9, "TSMI_n 下界映射")
    near(20.0 * clamp(-tsmi_norm(worst) / 0.15), 20.0, 1e-9, "CriticalPenalty 满额条件可达")

    # —— 收敛判定五态（F5/F8 + B3）——
    ce = ConvergenceEngine(target=85.0)
    ce.modified = {"V20"}
