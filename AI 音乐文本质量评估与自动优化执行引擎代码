PAUSE_RE = re.compile(r"\[\s*(?:pause|silence)\s+([0-9]*\.?[0-9]+)\s*s\s*\]$$", re.I)          # B2
BAD_PAUSE_RE = re.compile(r"$$\s*(?:pause|silence)\s*$$|$$\s*(?:停顿|呼吸|沉默)\s*$$", re.I)  # B2
ABRUPT_RE = re.compile(r"$$\s*abrupt\s*stop\s*$$", re.I)                                     # B2
SILENCE_RE = re.compile(r"$$\s*silence\b[^$$]*\]", re.I)                                      # B8
SEC_HEADER_RE = re.compile(r"^\s*$$([^\[$$\n]{1,48})\]")                                      # F12
ENERGY_RE = re.compile(r"$$\s*(?:energy\s*:?\s*)?(very soft|building stronger|building|released but held back|"
                       r"more released|released|naked voice|full voice[^,$$]*|cracks open|silence|"
                       r"low energy groove|cool[^,\]]*|controlled power|slightly hotter|full energy|"
                       r"breakdown[^,\]]*|beyond full|losing control|abrupt stop)\s*\]", re.I)  # B2
DB_RE = re.compile(r"([-+]?[0-9]+(?:\.[0-9]+)?)\s*dB", re.I)
BAR_RE = re.compile(r"$$(?:verse|chorus|bridge|intro|outro)[^$$]*?\b(\d{1,2})\s*(?:bars?|小节)\b[^\]]*\]",
                    re.I)                                                                     # B2/B7
BAD_TAG_SUB_RE = re.compile(r"$$\s*(?:pause|silence|停顿|呼吸|沉默)\s*$$", re.I)


def sec_kind(tag: str) -> str:
    t = tag.lower()
    if "pre" in t and "chorus" in t:
        return "prechorus"
    for key, val in (("prechorus", "prechorus"), ("副歌前", "prechorus"),
                     ("chorus", "chorus"), ("verse", "verse"), ("bridge", "bridge"),
                     ("interlude", "interlude"), ("intro", "intro"), ("outro", "outro"),
                     ("副歌", "chorus"), ("主歌", "verse"), ("尾奏", "outro"),
                     ("前奏", "intro"), ("间奏", "interlude"), ("橋段", "bridge"), ("桥段", "bridge")):
        if key in t:
            return val
    return "other"


def _split_header(line: str) -> Optional[Tuple[str, str]]:
    """F12 行级段落头：首标签必须是段落名；允许行内附加标签/正文（[Bridge] [Cut] [pause …]）。"""
    m = SEC_HEADER_RE.match(line)
    if not m:
        return None
    tag = m.group(1).strip()
    if sec_kind(tag) == "other":
        return None                                    # [pause 1.0s] / [Energy: …] 不是段落头
    return tag, line[m.end():].strip()


def split_sections(text: str) -> List[Tuple[str, str, List[str]]]:
    """返回 [(原始标签, 类型, 行列表)]；首个段落头之前的正文归为 'head'/'body'。"""
    out: List[Tuple[str, str, List[str]]] = []
    head: List[str] = []
    cur_tag: Optional[str] = None
    cur_kind = "other"
    cur_body: List[str] = []

    def flush() -> None:
        nonlocal cur_tag, cur_kind, cur_body
        if cur_tag is not None:
            out.append((cur_tag, cur_kind, cur_body))
        cur_tag, cur_kind, cur_body = None, "other", []

    for raw in text.split("\n"):
        h = _split_header(raw)
        if h is not None:
            flush()
            cur_tag, rest = h
            cur_kind = sec_kind(cur_tag)
            cur_body = [rest] if rest else []
        else:
            if not raw.strip():
                continue
            if cur_tag is None:
                head.append(raw.strip())
            else:
                cur_body.append(raw.strip())
    flush()
    if not out:
        return [("body", "other", head)]
    if head:
        out.insert(0, ("head", "other", head))
    return out


def _block_index(lines: Sequence[str]) -> List[Tuple[int, str, str]]:
    """[(行号, 标签, 类型)]，与 split_sections 同一口径（B9 行级编辑基础）。"""
    out: List[Tuple[int, str, str]] = []
    for i, ln in enumerate(lines):
        h = _split_header(ln)
        if h:
            out.append((i, h[0], sec_kind(h[0])))
    return out


def _block_body(lines: Sequence[str], idx: Sequence[Tuple[int, str, str]], pos: int) -> Tuple[int, int]:
    start = idx[pos][0] + 1
    end = idx[pos + 1][0] if pos + 1 < len(idx) else len(lines)
    return start, end


def hits(text: str, vocab: Sequence[str]) -> List[str]:
    low = text.lower()
    return [t for t in vocab if t and t.lower() in low]          # B6: 过滤空 token


def _hook_clean(s: str) -> str:
    return re.sub(r"[^\w\u3400-\u9fff]", "", s)                   # B13


def _object_link(tail: str, hook: str) -> bool:
    """B4：物象关联 = 尾句含寄生词或 Hook 本身；空 Hook 不得把整张表清空。"""
    vocab = PARA_SPA + PARA_TAC + PARA_TEM + ([hook] if hook else [])
    return bool(hits(tail, vocab))


def syllable_est(line: str) -> int:
    """启发式：汉字/粤字计 1 音节，连续拉丁词计 1。R4 音节预算用。"""
    han = len(re.findall(r"[\u3400-\u9fff\uf900-\ufaff]", line))
    words = len(re.findall(r"[A-Za-z']+", line))
    return han + words


def rhyme_density(lines: Sequence[str]) -> float:
    """代理指标：句尾字众数占比（真实押韵需韵部表，见线下事项）。"""
    tails = [re.sub(r"[^\w\u3400-\u9fff]", "", ln)[-1:] for ln in lines if ln.strip()]
    tails = [t for t in tails if t]
    if len(tails) < 2:
        return 0.0
    modal = max(tails.count(t) for t in set(tails))
    return modal / len(tails)


@dataclass
class Features:
    lang: str
    style_name: str
    fast: bool
    styles: str
    lyrics: str
    sections: List[Tuple[str, str, List[str]]] = field(default_factory=list)
    style_desc_count: int = 0
    v: Dict[str, object] = field(default_factory=dict)
    pac_nodes: List[PacNode] = field(default_factory=list)
    tone_events: List[ToneEvent] = field(default_factory=list)
    nsrq_slots: Dict[str, float] = field(default_factory=dict)
    abrupt_stop: bool = False
    c3ac_dcl: Tuple[float, float, float] = (0.0, 0.0, 0.0)
    warnings: List[str] = field(default_factory=list)


def extract_features(styles: str, lyrics: str, lang: str, style_name: str,
                     hook_hint: str = "") -> Features:
