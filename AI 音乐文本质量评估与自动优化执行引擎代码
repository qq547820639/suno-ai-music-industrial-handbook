    f = Features(lang, style_name, meta["fast"], styles, lyrics)
    f.sections = split_sections(lyrics)
    S, L = styles, lyrics
    low_s = S.lower()

    # ---- Styles 侧 ----
    f.style_desc_count = len([p for p in re.split(r"[,;，；]", S) if p.strip()])
    f.v["vocal"] = hits(S, ["breathy", "rasp", "fry", "vibrato", "falsetto", "head voice", "chest voice",
                            "baritone", "tenor", "mezzo", "conversational", "rubato", "melismatic",
                            "nasal", "grain", "whisper", "belt", "voice cracks", "breath intake"])
    f.v["vocal_reg"] = hits(S, ["baritone", "tenor", "soprano", "alto", "bass", "head voice",
                                "chest voice", "falsetto", "vocal register"])
    f.v["vocal_tech"] = hits(S, ["vibrato", "breathy", "rasp", "fry", "melismatic", "rubato",
                                 "belt", "legato", "staccato", "ad-lib", "cracks"])
    f.v["vocal_diction"] = hits(S, ["diction", "articulation", "conversational", "slurred", "crisp", "phrasing"])
    f.v["vocal_air_vib"] = hits(S, ["breathy", "breath intake", "vibrato"])
    f.v["vocal_dyn"] = hits(S, ["dynamic", "crescendo", "decrescendo", "swell", "restrained", "held back", "full voice"])
    f.v["vocal_res"] = hits(S, ["resonance", "nasal placement", "chest resonance", "mask"])
    f.v["vocal_adv"] = hits(S, ["vocal fry on low notes", "melismatic runs", "controlled rasp",
                                "conversational rubato", "breath intake sounds included",
                                "head voice dominant", "subtle nasal placement"])

    f.v["style_era"] = hits(S, ["70s", "80s", "90s", "2000s", "retro", "vintage", "modern"])
    f.v["style_region"] = hits(S, ["cantopop", "mandopop", "city pop", "hong kong", "shanghai", "taiwan"])
    f.v["style_main"] = hits(S, ["ballad", "funk", "rock", "synth-pop", "dance", "folk", "electronic",
                                 "orchestral", "r&b", "soul", "dark", "experimental", "band sound"])
    f.v["style_sub"] = hits(S, ["piano ballad", "syncopated", "mid-tempo", "half-time", "four on the floor",
                                "fingerpicked", "industrial", "granular", "operatic", "laid-back"])
    f.v["style_feat"] = hits(S, ["unhurried", "detached", "raw", "burn", "groove", "pocket", "collage",
                                 "drone", "swell", "storytelling", "melancholy", "rubato", "breakdown"])
    f.v["style_harm"] = hits(S, ["ii-v-i", "borrowed chord", "secondary dominant", "chromatic mediant", "syncopated"])
    f.v["style_purity"] = hits(S, ["authentic", "pure", "traditional", "genuine", "true to"])

    f.v["instr"] = hits(S, ["felt piano", "piano", "rhodes", "wurlitzer", "hammond", "guitar", "bass",
                            "drums", "synth", "strings", "timpani", "pad", "organ", "cello", "violin",
                            "808", "drum machine", "electric bass", "acoustic", "upright bass", "brushed drums"])
    f.v["instr_mod"] = hits(S, ["felt", "vintage", "analog", "warm", "clean", "muted", "nylon", "electric",
                                "upright", "tape", "room mic", "soft pedal", "overdriven", "distorted",
                                "fingerpicked", "fingered", "brushed", "detuned"])
    f.v["instr_layer"] = hits(S, ["background", "under", "behind", "sparse", "dense", "counter", "fills",
                                  "bed", "top", "texture", "collage", "only", "above"])

    f.v["mix"] = hits(S, ["glue compression", "mid-side", "parallel compression", "tape saturation",
                          "analog warmth", "clean mix", "punchy", "dynamic range", "lufs", "loudness",
                          "compression", "saturation", "balanced"])
    f.v["mix_freq"] = hits(S, ["sidechain", "eq", "notch", "scooped", "low-mid", "high-pass",
                               "harsh-free", "smooth high end"])
    f.v["mix_stereo"] = hits(S, ["wide stereo", "stereo field", "pan", "mono-compatible", "off-center", "mid-side"])
    f.v["db_vals"] = DB_RE.findall(S)

    f.v["space"] = hits(S, ["reverb", "plate", "room", "hall", "spring", "chamber", "delay",
                            "slapback", "echo", "echoplex", "emt 140", "ambient", "dry"])
    f.v["space_time"] = re.findall(r"([0-9]+(?:\.[0-9]+)?)\s*(?:s\b|ms\b)", low_s)

    f.v["low"] = hits(S, ["bass", "sub-bass", "808", "upright bass", "synth bass", "bassline",
                          "kick", "low end", "fingered", "slap pocket", "half-time"])
    f.v["high"] = hits(S, ["air", "sheen", "bright", "shimmer", "sparkle", "hi-hat", "cymbal", "shaker",
                           "smooth high end", "no harsh", "harsh-free", "de-ess", "presence", "crisp"])
    f.v["dyn"] = hits(S, ["crescendo", "decrescendo", "swell", "dynamic", "building", "released", "soft",
                          "loud", "quiet", "drop", "breakdown", "abrupt stop", "energy", "very soft",
                          "full voice", "held back", "burn", "build"])
    f.v["exclude"] = re.findall(r"\bno\b[^,;.]{2,42}", low_s)
    f.v["vocal_mix"] = DB_RE.findall(S) + (["above band"] if ("above band" in low_s or "above instruments" in low_s) else [])

    # ---- Lyrics 侧 ----
    lines = [ln for _, _, body in f.sections for ln in body]
    f.v["psycho"] = hits(L, PSYCHO_WORDS)
    f.v["passive"] = hits(L, PASSIVE_FIND)
    f.v["explain"] = hits(L, EXPLAIN)
    f.v["summary"] = hits(L, SUMMARY_WORDS)
    f.v["canto"] = hits(L, CANTO_SPOKEN) if lang == "yue" else []
    f.v["shumian"] = hits(L, SHUMIAN_WORDS) if lang == "cmn" else []      # B6
    f.v["long_lines"] = [ln for ln in lines if syllable_est(ln) > 18]
    f.v["imagery"] = hits(L, HIGH_FREQ_IMAGERY)
    f.v["adv_verbs"] = hits(L, ADV_VERBS_YUE if lang == "yue" else ADV_VERBS_CMN)
    f.v["contact_v"] = hits(L, CONTACT_VERBS)
    f.v["turn_v"] = hits(L, TURN_VERBS)
    f.v["anchor_w"] = hits(L, ANCHOR_WORDS)
    f.v["abstract"] = hits(L, ["人生", "命运", "命運", "永恒", "存在", "哲学", "哲學", "灵魂", "靈魂",
                               "宇宙", "意义", "意義", "宿命", "轮回", "輪迴"])
    f.v["concrete"] = hits(L, ["早上", "凌晨", "加班", "打卡", "地铁", "地鐵", "电梯", "電梯", "便利店",
                               "末班车", "末班車", "工位", "厕所", "廁所", "茶水间", "茶水間", "会议室", "會議室"])
    f.v["unicode_flags"] = [(ch, hex(ord(ch))) for ch in L
                            if ord(ch) > 0x20000 or 0x3400 <= ord(ch) <= 0x4DBF]
    f.v["energy_tags"] = ENERGY_RE.findall(L)
    f.v["bad_pause"] = BAD_PAUSE_RE.findall(L)
    f.v["pause_vals"] = [float(x) for x in PAUSE_RE.findall(L)]
    f.v["silence_tag"] = bool(SILENCE_RE.search(L))                   # B8
    f.abrupt_stop = bool(ABRUPT_RE.search(L))

    # 结构
    kinds = [k for _, k, _ in f.sections]
    f.v["sec_kinds"] = kinds
    f.v["sec_with_content"] = [(t, k, len(b)) for t, k, b in f.sections]
    f.v["bar_counts"] = BAR_RE.findall(L)                             # B7

    # ---- NSRQ 槽位（顺序对位 + 越界忽略）----
    profile = FAST_PROFILE if f.fast else SLOW_PROFILE
    for i, (slot, _ideal, _w) in enumerate(profile):
        if i < len(f.v["pause_vals"]):                                # type: ignore
            f.nsrq_slots[slot] = f.v["pause_vals"][i]                 # type: ignore

    # ---- Hook / 副歌块 ----
    chorus_blocks = [b for _, k, b in f.sections if k == "chorus" and b]
    f.v["chorus_count"] = len(chorus_blocks)
    hook = hook_hint
    if not hook and chorus_blocks:
        cand = sorted({ln.strip() for ln in chorus_blocks[0] if 0 < len(_hook_clean(ln)) <= 4}, key=len)
        hook = cand[0] if cand else (_hook_clean(chorus_blocks[0][0])[:2] if chorus_blocks[0] else "")
    hook_clean = _hook_clean(hook)                                    # B13
    f.v["hook"] = hook_clean
    f.v["hook_len"] = len(hook_clean)
    all_text = "\n".join(lines)
    f.v["hook_repeat"] = all_text.count(hook_clean) if hook_clean else 0
    chorus_lines = [ln for b in chorus_blocks for ln in b]
    f.v["rhyme"] = rhyme_density(chorus_lines)
    f.v["hook_boost"] = {
        "句首重复": len(chorus_lines) >= 2 and len({ln[:1] for ln in chorus_lines}) < len(chorus_lines),
        "短语重复": f.v["hook_repeat"] >= 2,
        "尾韵密集": f.v["rhyme"] >= 0.5,
        "对比句式": bool(hits(L, ["却", "卻", "还是", "還是", "但", "而"])),
        "疑问感叹": ("？" in L or "?" in L or "！" in L or "!" in L),
        "标题词复现": bool(hook_clean) and f.v["hook_repeat"] >= 3,
    }

    # ---- Tone events（Hook 尾字 + 副歌/主歌句尾）----
    tail_char = hook_clean[-1] if hook_clean else ""
    tone = lookup_tone(tail_char, lang) if tail_char else None
    if tone:
        f.tone_events.append(ToneEvent(lang, style_name, tone, "hook"))
    else:
        f.warnings.append(f"TSMI: Hook 尾字「{tail_char or '?'}」声调未知，"
                          f"按中性事件（系数 1.0、基分 {NEUTRAL_TONE_SCORE:g}）计并需人工复核")
        if tail_char:
            f.tone_events.append(ToneEvent(lang, style_name, "?", "hook", neutral=True))   # F11
    for _, k, body in f.sections:
        pos = "chorus" if k == "chorus" else "verse" if k == "verse" else None
        if not pos:
            continue
        for ln in body[:4]:
            t = _hook_clean(ln)
            if not t:
                continue
            tt = lookup_tone(t[-1], lang)
            if tt:
                f.tone_events.append(ToneEvent(lang, style_name, tt, pos))

    # ---- PAC 自动候选（初始/接触/转折/落点 + 寄生形态）----
    def parasite_of(text: str) -> str:
        if hits(text, PARA_TEM):
            return "temporal"
        if hits(text, PARA_TAC):
            return "tactile"
        if hits(text, PARA_SPA):
            return "spatial"
        return "none"

    flat = all_text
    first_line = next((ln for _, _, body in f.sections for ln in body), "")
    f.pac_nodes.append(PacNode("initial", parasite_of(first_line), first_line[:20]))
    contact_line = next((ln for ln in lines if hits(ln, CONTACT_VERBS)), "")
    if contact_line:
        f.pac_nodes.append(PacNode("contact", parasite_of(contact_line), contact_line[:20]))
    turn_line = next((ln for ln in lines if hits(ln, TURN_VERBS)), "")
    if turn_line:
        f.pac_nodes.append(PacNode("turn", parasite_of(turn_line), turn_line[:20]))
    outro = next((b for _, k, b in f.sections if k == "outro"), [])
    anchor_line = next((ln for ln in outro if re.search(r"[\u3400-\u9fff]", ln)), "")
    if anchor_line:
        f.pac_nodes.append(PacNode("anchor", parasite_of(anchor_line), anchor_line[:20]))
    f.v["parasite_any"] = any(n.parasite != "none" for n in f.pac_nodes)
    f.v["time_parasite"] = any(n.parasite == "temporal" for n in f.pac_nodes) or bool(hits(flat, PARA_TEM))

    # ---- C3AC 自动判定 ----
    c3 = chorus_blocks[-1] if chorus_blocks else []
    f.v["chorus3"] = c3
    if c3:
        head = "".join(c3[:2])
        tail = c3[-1]
        d_words = hits(head, C3AC_KB["识穿"][lang])
        claim_all = (C3AC_KB["认领"]["default"][lang] + C3AC_KB["认领"]["否认"][lang]
                     + C3AC_KB["认领"]["觉醒"][lang])
        c_words = hits(tail, claim_all)
        obj_link = _object_link(tail, hook_clean)                     # B4
        D = 1.0 if d_words else 0.0
        C = 1.0 if (c_words and obj_link) else 0.5 if c_words else 0.0
        ref = chorus_blocks[0] if len(chorus_blocks) > 1 else c3
        L_ = _skeleton_affinity(ref, c3, hook_clean)
        f.c3ac_dcl = (D, C, L_)
        f.v["c3ac_words"] = {"D": d_words, "C": c_words}
    else:
        f.warnings.append("C3AC: 未检测到副歌块，D/C/L 全 0")

    # ---- 15.3 / 15.2 防呆 ----
    if len(f.v["imagery"]) >= 2:                                      # type: ignore
        f.warnings.append(f"意象同质化风险：命中高频/AI 偏置词 {f.v['imagery']}")
    for ch, cp in f.v["unicode_flags"]:                               # type: ignore
        f.warnings.append(f"Unicode 兼容：{ch} ({cp}) → 建议 {UNICODE_SUBS.get(ch, '标注等效常用字')}")
    if f.v["bad_pause"]:
        f.warnings.append(f"V26 标注不合规（不带秒数）：{f.v['bad_pause']}（R6：改用 [pause X.Xs]）")
    if f.style_desc_count > PROMPT_FATIGUE_LIMIT:
        f.warnings.append(f"R1 Prompt fatigue：Styles 分段数 {f.style_desc_count} > {PROMPT_FATIGUE_LIMIT}，"
                          f"建议压到 {DESCRIPTOR_SWEET}")
    if not _has_fidelity(S, L):
        f.warnings.append("R3：缺保真指令 `Do not change any words. Sing exactly as written.`")
    return f


def _has_fidelity(styles: str, lyrics: str) -> bool:
    return "do not change" in (styles + " " + lyrics).lower()


def _skeleton_affinity(ref: Sequence[str], c3: Sequence[str], hook: str) -> float:
    """L 延续阶启发式：句式骨架（字符 bigram）重合度 + Hook 保留。阈值 0.6 / 0.3。"""
    def grams(lines: Sequence[str]) -> set:
        s = set()
        for ln in lines:
            t = _hook_clean(ln)
            s |= {t[i:i + 2] for i in range(len(t) - 1)}
        return s
    a, b = grams(ref), grams(c3)
    if not a or not b:
        return 0.0
    inter = len(a & b) / min(len(a), len(b))
    hook_ok = bool(hook) and any(hook in ln for ln in c3)
    score = inter + (0.15 if hook_ok else 0.0)
    return 1.0 if score >= 0.6 else 0.5 if score >= 0.3 else 0.0


# ══════════════════════════════════════════════════════════════
#  28 维度启发式预检评分（自动 + 人工覆盖）
# ══════════════════════════════════════════════════════════════


@dataclass
class ScoreNote:
    code: str
    score: float
    reason: str


def autoscore(f: Features) -> Tuple[Dict[str, float], List[ScoreNote], List[str]]:
    S: Dict[str, float] = {}
    notes: List[ScoreNote] = []
    vetoes: List[str] = []
    lang = f.lang

    def put(code: str, val: float, why: str, veto: bool = False) -> None:
        S[code] = round(val, 2)
        notes.append(ScoreNote(code, S[code], why))
        if veto:
            vetoes.append(code)

    # ---- V1 人声 ----
    if not f.v["vocal"]:
        put("V1", 1, "无人声标签（一票否决）", True)
    else:
        s = 2
        if f.v["vocal_reg"] and len(f.v["vocal_tech"]) >= 1:               # type: ignore
            s = 2
        if f.v["vocal_reg"] and len(f.v["vocal_tech"]) >= 2 and f.v["vocal_diction"]:   # type: ignore
            s = 3
        if (f.v["vocal_air_vib"] and f.v["vocal_dyn"] and f.v["vocal_res"]) or \
           (len(f.v["vocal_tech"]) >= 4 and f.v["vocal_dyn"]):             # type: ignore
            s = 4
        if s == 4 and f.v["vocal_adv"]:
            s = 5
        s += min(len(f.v["vocal_adv"]), 3) * 0.2            # type: ignore
        if f.style_desc_count > PROMPT_FATIGUE_LIMIT:
            s = min(s, 4)                                    # R1：prompt fatigue 封顶
            f.warnings.append("V1 因描述符过载封顶 4")
        put("V1", s, f"技法{len(f.v['vocal_tech'])}/高阶{len(f.v['vocal_adv'])}/描述符{f.style_desc_count}")

    # ---- V2 风格 ----
    if not f.v["style_main"]:
        put("V2", 1, "无风格标签（一票否决）", True)
    else:
        s = 2 if (f.v["style_era"] or f.v["style_region"]) else 1.5
        if f.v["style_era"] and f.v["style_region"] and f.v["style_main"] and f.v["style_sub"]:
            s = 3
        if s == 3 and len(f.v["style_feat"]) >= 3:                        # type: ignore
            s = 4
        if s == 4 and f.v["style_harm"] and f.v["style_purity"]:
            s = 5
        s += min(len(f.v["style_harm"]), 3) * 0.3                         # type: ignore
        if f.style_desc_count > PROMPT_FATIGUE_LIMIT:
            s = min(s, 4)
        put("V2", s, f"年代{len(f.v['style_era'])}/地域{len(f.v['style_region'])}"
                     f"/特征{len(f.v['style_feat'])}/和声{len(f.v['style_harm'])}")

    # ---- V3 配器 ----
    if not f.v["instr"]:
        put("V3", 1, "无配器标签（一票否决）", True)
    else:
        n = len(set(f.v["instr"]))                                # type: ignore
        s = 2 if n >= 2 else 1.5
        if n >= 4 and f.v["instr_mod"] and f.v["instr_layer"]:
            s = 3
        if s == 3 and n >= 5 and len(f.v["instr_mod"]) >= 3:      # type: ignore
            s = 4
        if s == 4 and len(f.v["instr_layer"]) >= 2:               # type: ignore  R1：总数 ≥10 门槛废止
            s = 5
        s += min(len(f.v["instr_mod"]), 3) * 0.1                  # type: ignore
        put("V3", s, f"乐器{n}/修饰{len(f.v['instr_mod'])}/层次{len(f.v['instr_layer'])}")

    # ---- V4 混音 ----
    if not f.v["mix"]:
        put("V4", 1, "无混音标签（一票否决）", True)
    else:
        s = 2 if f.v["mix"] else 1
        if len(f.v["mix"]) >= 2:                                  # type: ignore
            s = 3
        if s == 3 and f.v["mix_freq"] and f.v["mix_stereo"]:
            s = 4
        if s == 4 and any("lufs" in t or "loudness" in t for t in f.v["mix"]) \
                and len(f.v["mix"]) >= 3:                         # type: ignore
            s = 5
        if f.v["db_vals"]:
            s += 0.5
        put("V4", s, f"混音{len(f.v['mix'])}/频率{len(f.v['mix_freq'])}/声场{len(f.v['mix_stereo'])}")

    # ---- V5 空间 ----
    if not f.v["space"]:
        put("V5", 1, "无空间标签（一票否决）", True)
    else:
        s = 2 if any("reverb" in t or "room" in t or "hall" in t for t in f.v["space"]) else 1.5   # type: ignore
        if any("delay" in t or "echo" in t or "slapback" in t for t in f.v["space"]):               # type: ignore
            s = 3
        if s == 3 and len(f.v["space"]) >= 3:                     # type: ignore
            s = 4
        if s == 4 and f.v["space_time"]:
            s = 5
            s += 0.5
        put("V5", s, f"空间标签{len(f.v['space'])}/时值{f.v['space_time']}")

    # ---- V6 低频 ----
    if not f.v["low"]:
        put("V6", 1, "无低频标签（一票否决）", True)
    else:
        s = 2
        if len(f.v["low"]) >= 2:                                  # type: ignore
            s = 3
        if s == 3 and len(f.v["low"]) >= 3:                       # type: ignore
            s = 4
        if s == 4 and any("sub" in t or "low end" in t for t in f.v["low"]):   # type: ignore
            s = 5
            s += 0.5
        put("V6", s, f"低频标签{len(f.v['low'])}")

    # ---- V7 高频 ----
    if not f.v["high"]:
        put("V7", 1, "无高频标签（一票否决）", True)
    else:
        s = 2
        if len(f.v["high"]) >= 2:                                  # type: ignore
            s = 3
        if s == 3 and any("smooth" in t or "harsh-free" in t or "de-ess" in t for t in f.v["high"]):  # type: ignore
            s = 4
        if s == 4 and any(t in ("air", "sheen") for t in f.v["high"]):         # type: ignore
            s = 5
            s += 0.5
        put("V7", s, f"高频标签{len(f.v['high'])}")

    # ---- V8 动态 ----
    if not f.v["dyn"]:
        put("V8", 1, "无动态标签（一票否决）", True)
    else:
        s = 2 if len(f.v["dyn"]) >= 1 else 1                       # type: ignore
        if len(f.v["dyn"]) >= 3:                                   # type: ignore
            s = 3
        if s == 3 and len(f.v["dyn"]) >= 5:                        # type: ignore
            s = 4
        if s == 4 and len(f.v["energy_tags"]) >= 3:                # type: ignore
            s = 5
            s += min(max(len(f.v["energy_tags"]) - 3, 0), 4) * 0.2  # type: ignore
        put("V8", s, f"动态词{len(f.v['dyn'])}/段落标注{len(f.v['energy_tags'])}")

    # ---- V9 结构 ----
    kinds: List[str] = f.v["sec_kinds"]  # type: ignore
    if not kinds or all(k == "other" for k in kinds):
        put("V9", 1, "无结构标签（一票否决）", True)
    else:
        has_v = "verse" in kinds
        has_c = "chorus" in kinds
        s = 2 if (has_v and has_c) else 1
        if kinds.count("verse") >= 2 and kinds.count("chorus") >= 2:
            s = 3
        extra = sum(1 for k in ("intro", "bridge", "outro") if k in kinds)
        if s == 3 and extra >= 2:
            s = 4
        full = all(k in kinds for k in ("intro", "verse", "chorus", "bridge", "outro"))
        content_ok = all(n > 0 for _t, _k, n in f.v["sec_with_content"] if _k in ("verse", "chorus"))  # type: ignore
        if s == 4 and full and content_ok:
            s = 5
        if f.v["bar_counts"]:
            s += 0.5                                         # R5：bar count targeting
        if f.v["instr_layer"]:
            s += 0.2
        put("V9", s, f"结构块{kinds}/小节标注{f.v['bar_counts']}")

    # ---- V10 Hook（Styles 侧）----
    if not f.v["chorus_count"]:
        put("V10", 1, "无副歌（一票否决）", True)
    else:
        s = 2 if f.v["chorus_count"] >= 1 else 1                  # type: ignore
        if f.v["chorus_count"] >= 2 or f.v["hook_repeat"] >= 2:   # type: ignore
            s = 3
        boosts = sum(1 for x in f.v["hook_boost"].values() if x)  # type: ignore
        if s == 3 and boosts >= 2 and f.v["rhyme"] >= 0.5:        # type: ignore
            s = 4
        if s == 4 and boosts >= 3 and f.v["rhyme"] >= 0.7:        # type: ignore
            s = 5
        if f.v["rhyme"] >= 0.9:                                   # type: ignore
            s += 0.5
        put("V10", s, f"副歌{f.v['chorus_count']}/复现{f.v['hook_repeat']}/押韵率{f.v['rhyme']:.0%}")

    # ---- V11 情绪一致 ----
    emo_style = hits(f.styles, ["melancholy", "sad", "dark", "somber", "cold", "detached",
                                "uplifting", "joyful", "euphoric", "bright", "cheerful", "warm", "ominous"])
    neg = len(hits(f.lyrics, ["痛", "泪", "淚", "哭", "碎", "裂", "冷", "伤", "傷", "孤", "遗", "遺",
                              "失", "锈", "鏽", "旧", "舊", "沉默", "麻木", "困", "坏", "壞"]))
    pos = len(hits(f.lyrics, ["笑", "光", "暖", "甜", "自由", "拥抱", "擁抱", "晴", "花开", "花開"]))
    if not emo_style:
        put("V11", 1, "Styles 无情绪标签（一票否决）", True)
    else:
        style_neg = len([t for t in emo_style
                         if t in ("melancholy", "sad", "dark", "somber", "cold", "detached", "ominous")])
        style_pos = len(emo_style) - style_neg
        agree = (style_neg > style_pos and neg > pos) or (style_pos >= style_neg and pos >= neg)
        if not agree and abs(neg - pos) > 3:
            put("V11", 1, "情绪明显相反（一票否决）", True)
        else:
            s = 2 if agree else 1.5
            if len(emo_style) >= 2:
                s = 3
            match = 1.0 if agree else 0.6
            if s == 3 and match >= 0.8:
                s = 4
            if s == 4 and len(f.v["energy_tags"]) >= 3:           # type: ignore
                s = 5
            put("V11", s, f"Styles 情绪词{emo_style}／歌词负{neg}正{pos}")

    # ---- V12 人声前置 ----
    if not f.v["vocal_mix"]:
        put("V12", 1, "无人声比例标签（一票否决）", True)
    else:
        s = 2
        vals = [float(x) for x in f.v["db_vals"]]                 # type: ignore
        if vals:
            s = 3
            if all(1.0 <= abs(v) <= 4.0 for v in vals):
                s = 4
            if all(abs(round(v * 2) / 2 - v) < 1e-6 for v in vals):
                s = 5
        if any(t in ("eq", "sidechain") for t in f.v["mix_freq"]):   # type: ignore
            s += 0.5
        put("V12", s, f"dB 值{f.v['db_vals']}")

    # ---- V13 排除项（R2 修订：2–4 个精准为宜）----
    excl = f.v["exclude"]                                     # type: ignore
    if not excl:
        put("V13", 1, "无排除标签（一票否决）", True)
    else:
        n = len(excl)
        s = 2
        if 2 <= n <= 4 and f.v["style_purity"]:
            s = 3
        if 3 <= n <= 5 and any("reverb" in t or "pitch" in t or "doubling" in t for t in excl):
            s = 4
        if n >= 2 and any("artifact" in t or "quantization" in t or "doubling" in t for t in excl):
            s = 5
        if n > 5:
            s = min(s, 3)
            f.warnings.append(f"R2：NO 标签 {n} 个 > 5，触发 prompt fatigue 风险，建议正向改写")
        put("V13", s, f"排除标签{n}：{excl[:4]}")

    # ---- V24 / V25 / V26 / V28（先算，V15–V23 需要部分结果）----
    sing_tags = hits(f.styles, ["breathy", "cracks", "fry", "rasp", "zero pitch correction",
                                "held back", "naked", "whisper"]) + (["零修音"] if "零修音" in f.styles else [])
    s24 = 20 if (len(sing_tags) >= 3 and any("crack" in t or "zero" in t for t in sing_tags)) else \
          15 if len(sing_tags) >= 2 else 8 if sing_tags else 5
    put("V24", s24, f"演唱质感标注{sing_tags}")

    target_instr = {"慢歌钢琴叙事": ["felt piano", "piano"], "民谣叙事": ["guitar", "upright"],
                    "Funky 中板冷感": ["rhodes", "bass"], "Synth-pop 舞曲": ["synth", "808"],
                    "Band Sound 撕裂": ["guitar", "drums"], "歌剧式管弦乐": ["strings", "timpani"],
                    "电子实验": ["synth", "drone"], "暗黑电子": ["sub-bass", "synth"],
                    "R&B/Soul": ["rhodes", "bass"]}[f.style_name]
    match = len(hits(f.styles, target_instr))
    s25 = 22 if match >= 2 else 15 if match == 1 else 8
    if f.v["space"]:
        s25 = min(25, s25 + 3)
    put("V25", s25, f"风格配器匹配 {match}/2")

    good_pause = len(f.v["pause_vals"])                       # type: ignore
    s26 = 23 if (good_pause >= 4 and not f.v["bad_pause"]) else \
          18 if good_pause >= 3 else 12 if good_pause >= 1 else 5
    if f.v["bad_pause"]:
        s26 = min(s26, 15)
    if f.abrupt_stop or bool(f.v["silence_tag"]):             # B8
        s26 = min(25, s26 + 2)
    put("V26", s26, f"带秒数停顿 {good_pause} 处／不合规 {f.v['bad_pause']}／收尾静默 {bool(f.v['silence_tag'])}")

    e_tags = len(f.v["energy_tags"])                          # type: ignore
    s28 = 31 if e_tags >= 7 else 25 if e_tags >= 5 else 18 if e_tags >= 3 else 10 if e_tags else 6
    if any("crack" in t.lower() or "losing control" in t.lower() or "beyond" in t.lower()
           for t in f.v["energy_tags"]):                      # type: ignore
        s28 = min(35, s28 + 4)
    put("V28", s28, f"动态标注 {e_tags} 处")

    # ---- V27 声调协音（TSMI 驱动）----
    base27 = 35 * clamp((tsmi_raw(f.tone_events) + 10.0) / 40.0)
    put("V27", round(base27, 1), f"TSMI_raw={tsmi_raw(f.tone_events):.2f} 映射")

    # ---- V20 Hook（歌词）/ V21 结构 / V22 Bridge / V23 尾奏 ----
    hl = f.v["hook_len"]                                      # type: ignore
    s20 = 25
    if hl and hl <= 4:
        s20 = 32
    if f.v["hook_repeat"] >= 4:                               # type: ignore
        s20 = 36
    boosts = sum(1 for x in f.v["hook_boost"].values() if x)  # type: ignore
    if boosts >= 3 and f.v["hook_repeat"] >= 4:               # type: ignore
        s20 = 40
    if hl and hl > 4:
        s20 -= 5
    if f.tone_events and f.tone_events[0].coef > 1.2:
        s20 = min(45, s20 + 3)
    if f.tone_events and f.tone_events[0].coef < 0:
        s20 -= 5
    put("V20", max(0, s20), f"Hook「{f.v['hook']}」长{hl}/复现{f.v['hook_repeat']}/强化{boosts}种")

    arc = all(k in kinds for k in ("verse", "chorus", "bridge", "outro")) and kinds.count("chorus") >= 3
    s21 = 50 if arc else 40 if kinds.count("chorus") >= 2 and "bridge" in kinds else 28
    c3c = f.c3ac_dcl
    s21 += (c3c[0] + c3c[1] + c3c[2]) * 1.5
    outro_lines = next((b for _, k, b in f.sections if k == "outro"), [])
    if outro_lines and not hits("\n".join(outro_lines), SUMMARY_WORDS):
        s21 += 2
    put("V21", min(55, round(s21, 1)), f"弧线 D/C/L={c3c}／副歌{kinds.count('chorus')}")

    bridge_lines = next((b for _, k, b in f.sections if k == "bridge"), [])
    bridge_txt = "\n".join(bridge_lines)
    s22 = 10 if bridge_lines else 4
    if hits(bridge_txt, ["骤停", "驟停", "cut", "bare", "naked", "裸声", "裸聲"]):
        s22 += 10
    if bridge_lines and len(bridge_lines) <= 2:
        s22 += 8
    if bridge_lines and not hits(bridge_txt, EXPLAIN):
        s22 += 8
    s22 += nsrq_norm(nsrq_raw(f.nsrq_slots, f.fast, f.abrupt_stop), f.fast) * 4    # F10
    put("V22", min(40, round(s22, 1)),
        f"Bridge 行数{len(bridge_lines)}/骤停标注/解释词{hits(bridge_txt, EXPLAIN)}")

    s23 = 12
    if outro_lines:
        s23 = 20
        if len([ln for ln in outro_lines if re.search(r"[\u3400-\u9fff]", ln)]) <= 1:
            s23 += 6
        if f.v["pause_vals"] and max(f.v["pause_vals"]) >= 3:  # type: ignore
            s23 += 5
        if not hits("\n".join(outro_lines), SUMMARY_WORDS):
            s23 += 4
    put("V23", min(35, s23),
        f"Outro 行数{len(outro_lines)}/总结词{hits(chr(10).join(outro_lines), SUMMARY_WORDS)}")

    # ---- V15–V19 ----
    s15 = 18
    if f.v["concrete"]:
        s15 += 5
    if f.v["passive"]:
        s15 += 4
    if (f.v["concrete"] and f.v["passive"]) or (len(f.v["concrete"]) >= 2):   # type: ignore
        s15 = 26
    if f.v["concrete"] and f.v["passive"] and f.v["turn_v"]:
        s15 = 30
    if f.v["abstract"] and not f.v["concrete"]:
        s15 = min(s15, 12)
    put("V15", s15,
        f"日常瞬间词{len(f.v['concrete'])}/被动发现{len(f.v['passive'])}/抽象词{f.v['abstract']}")

    nodes = f.pac_nodes
    chain = len(nodes)
    s16 = 12 + chain * 4
    if f.v["parasite_any"]:
        s16 += 5
    if f.v["time_parasite"]:
        s16 += 3
    if chain >= 4 and f.v["parasite_any"]:
        s16 = 32
    if chain >= 4 and f.v["time_parasite"]:
        s16 = 35
    if f.v["imagery"] and chain <= 2:
        s16 = min(s16, 20)
    put("V16", min(35, s16), f"PAC 节点{chain}／寄生{[(n.kind, n.parasite) for n in nodes]}")

    acts = len(set(f.v["contact_v"] + f.v["turn_v"] + f.v["adv_verbs"]))   # type: ignore
    s17 = 12 + acts * 3 + (5 if f.v["passive"] else 0) + (3 if f.v["concrete"] else 0)
    s17 -= min(len(f.v["psycho"]), 5) * 2                                # type: ignore
    put("V17", max(0, min(35, s17)), f"具体动作{acts}／伪动作{f.v['psycho']}")

    s18 = 8 + min(len(f.v["adv_verbs"]), 5) * 3 + min(len(f.v["turn_v"]), 4) * 1.5   # type: ignore
    s18 -= min(len(f.v["explain"]), 4) * 2.5                                         # type: ignore
    put("V18", max(0, min(25, s18)), f"精准动词{f.v['adv_verbs']}／解释性{f.v['explain']}")

    vmax19 = lyrics_max("V19", lang)
    if lang == "yue":
        s19 = 6 + min(len(f.v["canto"]), 8) * 2 - min(len(f.v["long_lines"]), 5) * 2   # type: ignore
    else:
        s19 = 10 - min(len(f.v["shumian"]), 8) * 1.0 - min(len(f.v["long_lines"]), 5) * 1.5  # type: ignore
        s19 += 8 if len(f.v["long_lines"]) == 0 else 0                                   # type: ignore
    put("V19", max(0, min(vmax19, s19)),
        f"口语词{len(f.v['canto'])}/书面虚词{len(f.v['shumian'])}/长句{len(f.v['long_lines'])}")

    return S, notes, vetoes


