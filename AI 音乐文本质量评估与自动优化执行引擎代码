    yes(len(re.findall(r"\[Outro", ab.lyrics, re.I)) == 1, "B9 新建 Outro 唯一")
    yes(len(re.findall(r"\[Bridge", ab.lyrics, re.I)) == 1, "B9 新建 Bridge 唯一")
