@dataclass
class Asset:
    styles: str
    lyrics: str
    lang: str
    style_name: str
    hook: str = ""

    @property
    def fast(self) -> bool:
        return bool(STYLE_META[self.style_name]["fast"])


def _add_pause_block(ly: str, tags: str) -> str:
    """B9：已有 Bridge 则就地附加；否则新建 Bridge（插到 Outro 之前）。"""
    lines = ly.split("\n")
    idx = _block_index(lines)
    br = [p for p, (_i, _t, k) in enumerate(idx) if k == "bridge"]
    if br:
        i = idx[br[-1]][0]
        lines[i] = lines[i] + " [All Instruments Cut] " + tags
        return "\n".join(lines)
    outs = [p for p, (_i, _t, k) in enumerate(idx) if k == "outro"]
    at = idx[outs[0]][0] if outs else len(lines)
    lines[at:at] = ["[Bridge] [All Instruments Cut] " + tags]
    return "\n".join(lines)


def _add_silence_tail(ly: str, fast: bool) -> str:
    """B9：已有收尾静默/骤停则不动；已有 Outro 则补在其末尾；否则新建 Outro。"""
    tail = "[Abrupt Stop]" if fast else "[silence 5.0s]"
    if (fast and ABRUPT_RE.search(ly)) or (not fast and SILENCE_RE.search(ly)):
        return ly
    lines = ly.split("\n")
    idx = _block_index(lines)
    outs = [p for p, (_i, _t, k) in enumerate(idx) if k == "outro"]
    if outs:
        _s, e = _block_body(lines, idx, outs[-1])
        lines[e:e] = [tail]
    else:
        lines += ["[Outro]", tail]
    return "\n".join(lines)


def _inject_into_last_chorus(ly: str, head: bool, line: str) -> str:
    lines = ly.split("\n")
    idx = _block_index(lines)
    ch = [p for p, (_i, _t, k) in enumerate(idx) if k == "chorus"]
    if not ch:
        lines += ["[Chorus 3]", line]
        return "\n".join(lines)
    s, e = _block_body(lines, idx, ch[-1])
    body = list(lines[s:e])
    lines[s:e] = ([line] + body) if head else (body + [line])
    return "\n".join(lines)


def _restore_skeleton(ly: str) -> str:
    """把副歌1 的首句骨架复制到末位副歌的正文首行（Hook 位置回归）。"""
    lines = ly.split("\n")
    idx = _block_index(lines)
    ch = [p for p, (_i, _t, k) in enumerate(idx) if k == "chorus"]
    if len(ch) < 2:
        return ly
    s0, e0 = _block_body(lines, idx, ch[0])
    first = next((ln for ln in lines[s0:e0] if ln.strip()), "")
    if not first:
        return ly
    s1, e1 = _block_body(lines, idx, ch[-1])
    lines[s1:e1] = [first] + list(lines[s1:e1])
    return "\n".join(lines)


def _trim_outro(ly: str, fast: bool) -> Tuple[str, bool]:
    """Outro 去总结句，只留一个动作 + 收尾静默/骤停。"""
    lines = ly.split("\n")
    idx = _block_index(lines)
    outs = [p for p, (_i, _t, k) in enumerate(idx) if k == "outro"]
    if not outs:
        return ly, False
    s, e = _block_body(lines, idx, outs[-1])
    body = [ln for ln in lines[s:e] if ln.strip()]
    if not hits("\n".join(body), SUMMARY_WORDS):
        return ly, False
    keep = next((ln for ln in body if re.search(r"[\u3400-\u9fff]", ln)), "")
    tail = "[Abrupt Stop]" if fast else "[silence 5.0s]"
    lines[s:e] = ([keep] if keep else []) + [tail]
    return "\n".join(lines), True


def apply_fixes(a: Asset, feats: Features) -> Tuple[Asset, List[str], set]:
    diffs: List[str] = []
    touched: set = set()
    st, ly = a.styles, a.lyrics

    # 1) NSRQ：补带秒数的 pause（意图层）+ 执行层替代（R6）+ 收尾静默
    if not PAUSE_RE.search(ly):
        profile = FAST_PROFILE if a.fast else SLOW_PROFILE
        tags = " ".join(f"[pause {ideal}s]" for _s, ideal, _w in profile[:3])
        ly = _add_pause_block(ly, tags)                                   # B9
        diffs.append("[CHANGED] V26/NSRQ: 补入带秒数 pause 序列（意图层）；"
                     "执行层建议 'verse 2: bass rests for 4 bars' + [VERSE 2 · 8 bars]")
        touched |= {"V26", "V22", "V23"}
    tail_ly = _add_silence_tail(ly, a.fast)                                # B9
    if tail_ly != ly:
        ly = tail_ly
        diffs.append(f"[CHANGED] V23/NSRQ: Outro 末尾补 {'[Abrupt Stop]' if a.fast else '[silence 5.0s]'}")
        touched |= {"V23", "V26"}

    # 2) 不合规标注改写
    if feats.v["bad_pause"]:
        ly = BAD_TAG_SUB_RE.sub("[pause 1.0s]", ly)
        diffs.append("[CHANGED] V26: 不带秒数的停顿标注统一改为 [pause 1.0s]，请人工校准时长")
        touched.add("V26")

    # 3) C3AC：补 D / C / L
    d, c, l = feats.c3ac_dcl
    hook = feats.v["hook"] or a.hook or "它"                                # type: ignore
    if d < 1:
        ly = _inject_into_last_chorus(ly, head=True,
                                      line="原来我一直都知，只是唔出声" if a.lang == "yue"
                                      else "原来我早就知道，只是不出声")
        diffs.append("[CHANGED] C3AC(D=0→1): 副歌3 首句插入识穿句")
        touched |= {"V21", "V20"}
    if c < 1:
        ly = _inject_into_last_chorus(
            ly, head=False,
            line=f"留低佢啦，{hook} 继续喺个袋度" if a.lang == "yue" else f"留着吧，{hook} 就让它留在那里")
        diffs.append("[CHANGED] C3AC(C→1): 副歌3 末句插入认领动词 + 物象关联")
        touched.add("V21")
    if l < 0.5:
        ly = _restore_skeleton(ly)                                          # B13 签名收敛
        diffs.append("[CHANGED] C3AC(L→≥0.5): 副歌3 恢复副歌1 句式骨架与 Hook 位置")
        touched.add("V21")

    # 4) 尾奏：去总结、留一个动作
    ly2, changed = _trim_outro(ly, a.fast)                                  # B9
    if changed:
        ly = ly2
        diffs.append("[CHANGED] V23: Outro 总结句截断，仅保留一个动作 + 沉默")
        touched.add("V23")

    # 5) NO 标签正向改写（R2）
    for raw, pos in NO_REWRITE.items():
        if raw.lower() in st.lower():
            st = re.sub(re.escape(raw), pos, st, flags=re.I)
            diffs.append(f"[CHANGED] V13: 「{raw}」→ 正向「{pos}」")
            touched.add("V13")

    # 6) 保真指令（R3）
    if not _has_fidelity(st, ly):
        ly = "Do not change any words. Sing exactly as written.\n" + ly
        diffs.append("[CHANGED] R3: 歌词头部补保真指令，抑制偏置词注入")
        touched.add("V20")

    # 7) Styles 长度适配（15.1）：网页端 ~200 字符极限压缩（B10：按原文顺序保留）
    limit = 200
    if len(st) > limit:
        parts = [p.strip() for p in re.split(r"[,;，；]", st) if p.strip()]
        out: List[str] = []
        for p in parts:
            if sum(len(x) for x in out) + len(p) + 2 * len(out) <= limit:
                out.append(p)
        st = ", ".join(out)
        diffs.append(f"[CHANGED] 15.1: Styles 压缩到 {len(st)} 字符（网页端极限模式，保留原文靠前描述）")
        touched.add("V1")

    # 8) Unicode 替代（15.2）
    for ch, sub in UNICODE_SUBS.items():
        if ch in ly:
            ly = ly.replace(ch, sub)
            diffs.append(f"[CHANGED] 15.2: 扩展区字 {ch} → {sub}")
            touched.add("V18")

    return Asset(st, ly, a.lang, a.style_name, a.hook), diffs, touched


