@dataclass(frozen=True)
class PacNode:
    kind: str                    # initial / contact / turn / anchor
    parasite: str = "none"       # tactile / spatial / temporal / none
    evidence: str = ""

    def value(self) -> float:
        return NODE_WEIGHTS[self.kind] * PARASITE_COEFS[self.parasite]


@dataclass(frozen=True)
class ToneEvent:
    lang: str
    style: str
    tone: str
    pos: str = "hook"
    neutral: bool = False        # F11: 声调未知时的中性事件

    @property
    def tone_score(self) -> float:
        return NEUTRAL_TONE_SCORE if self.neutral else TONE_BASE[self.lang][self.tone]

    @property
    def coef(self) -> float:
        return 1.0 if self.neutral else style_coef(self.lang, self.style, self.tone)


def pac_raw(nodes: Sequence[PacNode]) -> float:
    return sum(n.value() for n in nodes)


def pac_norm(raw: float) -> float:
    return clamp(raw / PAC_DENOM)


def tsmi_raw(events: Sequence[ToneEvent]) -> float:
    """F3 口径：位置加权均值 × 2.0。事件数不放大。
    可达上界 30.0；KB 内可达下界 ≈ −9.6（粤语 Synth-pop 禁用声调 4），TSMI_n ≥ ≈ −0.32。"""
    if not events:
        return 0.0
    num = sum(e.tone_score * e.coef * POS_WEIGHTS[e.pos] for e in events)
    den = sum(POS_WEIGHTS[e.pos] for e in events)
    return 2.0 * num / den


def tsmi_norm(raw: float) -> float:
    return clamp(raw / 30.0, -1.0, 1.0)


def nsrq_raw(slots: Dict[str, float], fast: bool = False, abrupt_stop: bool = False) -> float:
    profile = FAST_PROFILE if fast else SLOW_PROFILE
    total = 0.0
    for slot, ideal, w in profile:
        if slot in slots and slots[slot] is not None:
            total += clamp(slots[slot] / ideal) * w     # F6: 超时不加分，防刷分
    if fast and abrupt_stop:
        total += 1.0
    return total


def nsrq_norm(raw: float, fast: bool = False) -> float:
    return clamp(raw / nsrq_denom(fast))


def c3ac_raw(d: float, c: float, l: float) -> float:
    for name, v in (("D", d), ("C", c), ("L", l)):
        if not (0.0 <= v <= 1.0):
            raise ValueError(f"{name} 必须落在 [0,1]: {v}")
    return 0.6 * d + 0.7 * c + 0.7 * l


def c3ac_norm(raw: float) -> float:
    return clamp(raw / 2.0)


BASE = {"yue": 340.0, "cmn": 335.0}


@dataclass
class TEEResult:
    pac_n: float
    tsmi_n: float
    nsrq_n: float
    c3ac_n: float
    tee_raw: float
    tee_pct_raw: float
    g: Tuple[float, float, float, float]
    g_struct: float
    soft_penalty: float
    critical_penalty: float
    crit_tsmi: float
    crit_pac: float
    crit_c3ac: float
    tee_pct_final: float

    def offset(self, lyrics_percent: float) -> float:
        return self.tee_pct_final - lyrics_percent


def tee_from_norm(pac_n: float, tsmi_n: float, nsrq_n: float,
                  c3ac_n: float, lang: str = "yue") -> TEEResult:
    tee_raw = (BASE[lang] + 32.0 * pac_n + 24.0 * tsmi_n + 20.0 * nsrq_n
               + 28.0 * c3ac_n + 16.0 * (pac_n * tsmi_n) + 12.0 * (nsrq_n * c3ac_n))
    tee_pct_raw = clamp(tee_raw / LYRICS_FULL[lang] * 100.0, 0.0, 100.0)

    g = tuple(clamp(0.85 * x + 0.15) for x in (pac_n, tsmi_n, nsrq_n, c3ac_n))
    if min(g) == 0.0:
        g_struct = 0.0                                     # 4.5: ln(0) 零值保护
    else:
        g_struct = math.exp(0.30 * math.log(max(g[0], EPS)) + 0.25 * math.log(max(g[1], EPS))
                            + 0.20 * math.log(max(g[2], EPS)) + 0.25 * math.log(max(g[3], EPS)))
    soft = 35.0 * (1.0 - g_struct)
    crit_tsmi = 20.0 * clamp(-tsmi_n / 0.15)               # 起扣 tsmi_n<0，满额 ≤ −0.15
    crit_pac = 10.0 * clamp((0.20 - pac_n) / 0.20)
    crit_c3ac = 10.0 * clamp((0.25 - c3ac_n) / 0.25)
    crit = crit_tsmi + crit_pac + crit_c3ac
    final = clamp(tee_pct_raw - soft - crit, 0.0, 100.0)
    return TEEResult(pac_n, tsmi_n, nsrq_n, c3ac_n, tee_raw, tee_pct_raw, g, g_struct,
                     soft, crit, crit_tsmi, crit_pac, crit_c3ac, final)


def styles_percent(scores: Dict[str, float]) -> float:
    """F1/F7/F9: V1–V13 相对权重，分母 103 归一化；V14 不回流；得分封顶 vmax。"""
    total = sum((norm_score(d.code, scores.get(d.code, 0.0)) / 5.0) * d.weight
                for d in STYLE_DIMS if d.weight)
    return clamp(total / STYLE_DENOM * 100.0, 0.0, 100.0)


def lyrics_percent(scores: Dict[str, float], lang: str) -> float:
    total = sum(norm_score(d.code, scores.get(d.code, 0.0), lang) for d in LYRICS_DIMS)
    return clamp(total / LYRICS_FULL[lang] * 100.0, 0.0, 100.0)


def final_score(styles_p: float, lyrics_p: float, tee_offset: float,
                b_offset: float = 0.0, e_bonus: float = 0.0) -> float:
    return clamp(styles_p * 0.4 + lyrics_p * 0.6 + tee_offset + b_offset + e_bonus, 0.0, 100.0)


def grade(total: float) -> str:
    return ("S+（卓越级，可直接发行）" if total >= 95 else
            "S（优秀级，可直接商用）" if total >= 85 else
            "A（合格级，建议微调后商用）" if total >= 75 else
            "B（待改进，需重点优化）" if total >= 60 else "C（不合格，不可用）")


