    yes(0.0 <= ev.total <= 100.0, "端到端总分区间")
    yes(ev.tee.pac_n > 0, "端到端 PAC_n > 0")
    yes(bool(ev.feats.v["silence_tag"]) is True, "B8 收尾静默识别")
    yes(ev.lyrics_scores.get("V20", 0) > 0 and "人工" not in
        next((n.reason for n in ev.notes if n.code == "V20"), ""), "回写说明存在")
