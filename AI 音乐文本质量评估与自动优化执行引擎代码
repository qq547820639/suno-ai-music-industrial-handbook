    ce.record(2, 70.5, {"V20": 30.0})
    ce.record(3, 70.8, {"V20": 30.0})
    yes(ce.verdict()[0] == "振荡锁定，需人工介入", f"B3 振荡优先 {ce.verdict()}")
    ce2 = ConvergenceEngine(target=85.0)
