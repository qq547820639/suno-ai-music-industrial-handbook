@dataclass
class Diagnostic:
    rank: int
    code: str
    layer: str
    ratio: float
    issue: str
    fix: str


def diagnose(scores: Dict[str, float], lang: str, tee: TEEResult,
             vetoes: Sequence[str] = ()) -> List[Diagnostic]:
    items: List[Diagnostic] = []
    for code, sc in scores.items():
        if code not in ALL_DIMS:
            continue
        d = ALL_DIMS[code]
        mx = float(lyrics_max(code, lang))                 # F9: 口径统一
        ratio = norm_score(code, sc, lang) / mx
        th = THRESH[d.layer]
        if code in vetoes:
            rank = 1
        elif d.layer == "Core" and ratio < th:
            rank = 2
        elif d.layer == "Important" and ratio < th and (th - ratio) * mx > 5:
            rank = 4
        elif d.layer == "Important" and ratio < th:
            rank = 5
        elif d.layer == "Auxiliary" and ratio < th:
            rank = 6
        else:
            continue
        items.append(Diagnostic(rank, code, d.layer, ratio,
                                f"得分率 {ratio:.0%} < {d.layer} 阈值 {th:.0%}",
                                FIX_RULES.get(code, "按该维度量化档位补齐")))
    if tee.tsmi_n < 0:
        items.append(Diagnostic(3, "TSMI", "Core", tee.tsmi_n, "声调方向错误，起扣 CriticalPenalty", FIX_RULES["TSMI"]))
    if tee.pac_n < 0.20:
        items.append(Diagnostic(3, "PAC", "Core", tee.pac_n, "物象几乎无寄生，起扣", FIX_RULES["PAC"]))
    if tee.c3ac_n < 0.25:
        items.append(Diagnostic(3, "C3AC", "Core", tee.c3ac_n, "弧线几乎未完成，起扣", FIX_RULES["C3AC"]))
    items.sort(key=lambda x: (x.rank, x.ratio))
    return items[:5]


class ConvergenceEngine:
    """修正案 F5/F8：Round1=Phase2；Phase3 内最多 2 轮；五态收敛。"""

    def __init__(self, target: float = 85.0, max_rounds: int = 3):
        self.target, self.max_rounds = target, max_rounds
        self.records: List[Tuple[int, float, Dict[str, float]]] = []
        self.modified: set = set()

    def record(self, rnd: int, total: float, dims: Dict[str, float]) -> None:
        self.records.append((rnd, total, dict(dims)))

    def oscillating(self) -> List[str]:
        """被改维度连续 3 轮得分不变（卡死/振荡锁定）。"""
        out = []
        for dim in self.modified:
            seq = [r[2][dim] for r in self.records if dim in r[2]]
            if len(seq) >= 3 and seq[-1] == seq[-2] == seq[-3]:
                out.append(dim)
        return sorted(out)

    def verdict(self) -> Tuple[str, str]:
        if not self.records:
            return ("未开始", "无评分记录")
        rnd, total, dims = self.records[-1]
        c1 = c2 = False
        if len(self.records) >= 2:
            _, pt, pd = self.records[-2]
            c1 = abs(total - pt) < 3.0
            c2 = all(abs(dims.get(k, 0.0) - pd.get(k, 0.0)) <= 2.0 for k in set(dims) | set(pd))
        c3 = total >= self.target
        osc = self.oscillating()
        c4 = rnd >= self.max_rounds
        if c3:
            return ("已收敛·达标", f"C3 触发：{total:.1f} ≥ 目标 {self.target}")
        if osc:                                              # B3: 振荡优先于 C1/C2
            return ("振荡锁定，需人工介入", f"振荡/卡死维度：{', '.join(osc)}")
        if c1 or c2:
            return ("已收敛·未达标", f"C1={c1} C2={c2}：分数稳定但未达目标，商用前需人工复核")
        if c4:
            return ("达到轮次上限，未完全收敛", f"已完成 {rnd} 轮，见下轮修正方向")
        return ("未完全收敛，建议进一步迭代", f"当前 {total:.1f}，距目标差 {self.target - total:.1f}")


