    yes(ce2.verdict()[0] == "已收敛·达标", "收敛·达标")
    ce3 = ConvergenceEngine(target=85.0)
    ce3.record(1, 62.0, {"V20": 30.0})
    ce3.record(2, 62.4, {"V20": 30.2})
    yes(ce3.verdict()[0] == "已收敛·未达标", f"收敛·未达标 {ce3.verdict()}")
    ce4 = ConvergenceEngine(target=85.0)
    ce4.record(3, 72.0, {"V20": 35.0})
    yes(ce4.verdict()[0] == "达到轮次上限，未完全收敛", "轮次上限")

    # —— 端到端冒烟（最小样本）+ 自动修正器结构不变量（B5/B8/B9）——
    sample_styles = ("Cantonese male warm baritone piano ballad, 68 BPM, breathy intimate conversational, "
                     "felt piano, glue compression, EMT 140 plate reverb 2.4s, crescendo, "
                     "verse chorus bridge outro, vocals mixed 2.5dB above band, NO vocal doubling")
    sample_lyrics = ("\nDo not change any words. Sing exactly as written.\n[Verse 1]\n"
                     "原来旧锁生锈，仍锁着那件事\n[Chorus 1]\n锁住\n[Chorus 3]\n"
                     "原来我一直都知\n留低佢啦，锁继续喺个袋度\n[Bridge] [All Instruments Cut] "
                     "[pause 0.5s] [pause 2.0s] [pause 3.0s]\n[Outro]\n锁掉在地上\n[silence 5.0s]")
    a = Asset(sample_styles, sample_lyrics, "yue", "慢歌钢琴叙事", hook="锁")
